# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online4tech_publisher
REDIS_URL=redis://localhost:6379

# Meta app settings. Keep all real values in the backend runtime secret store.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/meta/oauth/callback

# Server-side access token. Never place this in frontend variables or source control.
META_ACCESS_TOKEN=

# Temporary token check is disabled by default and never available in production.
META_CONNECTION_TEST_ENABLED=false
META_CONNECTION_TEST_KEY=

# Graph API version current at implementation time; review Meta changelog before upgrades.
META_GRAPH_API_VERSION=v27.0

# Generate with: openssl rand -base64 32. Keep this backend-only and stable.
TOKEN_ENCRYPTION_KEY=
