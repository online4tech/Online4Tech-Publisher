# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online4tech_publisher
REDIS_URL=redis://localhost:6379

# Configure these only in the server environment after creating the Meta app.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/meta/oauth/callback

# Generate a strong random key for encrypting stored access tokens.
TOKEN_ENCRYPTION_KEY=
